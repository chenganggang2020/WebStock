namespace sectorLeader {namespace {
void observationActive(const Cancel& cancel){active(cancel);need(!QThread::currentThread()->isInterruptionRequested(),"人工观察恢复已取消，未提交");}
struct ObservationConnection {
 QString name=QUuid::createUuid().toString();QSqlDatabase db=QSqlDatabase::addDatabase("QSQLITE",name);
 ObservationConnection(QString path,bool write,const Cancel& cancel){try{
  observationActive(cancel);need(QFileInfo(path).isFile(),"人工库不存在，恢复不创建数据库");QFile f(path);need(f.open(QIODevice::ReadOnly)&&f.read(16)==QByteArray("SQLite format 3\0",16),"人工库文件头损坏，原件保留");f.close();
  db.setDatabaseName(QUrl::fromLocalFile(QFileInfo(path).absoluteFilePath()).toString(QUrl::FullyEncoded)+(write?"?mode=rw":"?mode=ro"));db.setConnectOptions(write?"QSQLITE_OPEN_URI;QSQLITE_BUSY_TIMEOUT=100":"QSQLITE_OPEN_URI;QSQLITE_OPEN_READONLY;QSQLITE_BUSY_TIMEOUT=100");need(db.open(),"人工恢复只打开已有库");if(write)exec(db,"PRAGMA synchronous=FULL");
 }catch(...){close();throw;}}
 void close(){db.close();db={};QSqlDatabase::removeDatabase(name);}~ObservationConnection(){close();}
};
QString normalizedSql(QString sql){sql=sql.toLower();sql.remove(QRegularExpression("\\s+"));sql.replace("ifnotexists","");return sql;}
bool observationSchema(QSqlDatabase&db,const Cancel&cancel){
 observationActive(cancel);need(scalar(db,"PRAGMA application_id")==0x534c5631&&scalar(db,"PRAGMA user_version")==1,"不是当前原生人工库，拒绝初始化或升级");
 QMap<QString,QString> definitions{{"config","CREATE TABLE config(id INTEGER PRIMARY KEY CHECK(id=1),revision INTEGER NOT NULL,digest TEXT NOT NULL,payload BLOB NOT NULL)"},{"observations","CREATE TABLE observations(id TEXT PRIMARY KEY,sector_id TEXT NOT NULL,captured_at TEXT NOT NULL,digest TEXT NOT NULL,payload BLOB NOT NULL)"},{"imports","CREATE TABLE imports(digest TEXT PRIMARY KEY,applied_at TEXT NOT NULL)"},{"observation_restore_receipts","CREATE TABLE observation_restore_receipts(source_key TEXT PRIMARY KEY,payload BLOB NOT NULL)"}};QSet<QString>found;bool index=false;QSqlQuery q(db);
 need(q.exec("SELECT type,name,tbl_name,sql FROM sqlite_master"));while(q.next()){observationActive(cancel);auto type=q.value(0).toString(),name=q.value(1).toString(),table=q.value(2).toString(),definition=q.value(3).toString();if(type=="index"&&name.startsWith("sqlite_autoindex_")&&definitions.contains(table)&&definition.isEmpty())continue;
  if(type=="index"&&name=="observation_sector_time"&&table=="observations"&&normalizedSql(definition)==normalizedSql("CREATE INDEX observation_sector_time ON observations(sector_id,captured_at DESC,id)")){index=true;continue;}
  need(type=="table"&&definitions.contains(name)&&name==table&&normalizedSql(definition)==normalizedSql(definitions.value(name)),"人工库含未知结构、表、索引或触发器；原件保留");found.insert(name);
 }need(found.contains("config")&&found.contains("observations")&&found.contains("imports")&&index,"原人工库结构不完整，未重建");need(q.exec("PRAGMA quick_check")&&q.next()&&q.value(0).toString()=="ok"&&!q.next(),"人工库损坏，未修复");return found.contains("observation_restore_receipts");
}
QJsonObject observationJson(QByteArray data,int limit){need(!data.isEmpty()&&data.size()<=limit&&QString::fromUtf8(data).toUtf8()==data,"人工原字段JSON长度/UTF-8无效");watchlistBackup::JsonGate{QString::fromUtf8(data)}.run();QJsonParseError error;auto doc=QJsonDocument::fromJson(data,&error);need(error.error==QJsonParseError::NoError&&doc.isObject(),"人工原字段JSON损坏，原件保留");return doc.object();}
QJsonObject observationRead(QSqlDatabase&db,const Cancel&cancel,QString key={},QJsonObject*previous=nullptr){
 auto has=observationSchema(db,cancel);QSqlQuery q(db);need(scalar(db,"SELECT count(*) FROM config")<=1,"原配置主行异常");auto current=sectorLeader::empty();need(q.exec("SELECT id,revision,digest,payload,typeof(id),typeof(revision),typeof(digest),typeof(payload),length(payload) FROM config"));if(q.next()){
  need(q.value(0).toLongLong()==1&&q.value(4).toString()=="integer"&&q.value(5).toString()=="integer"&&q.value(6).toString()=="text"&&q.value(7).toString()=="blob"&&q.value(8).toLongLong()<=2*1024*1024,"人工原配置字段类型/长度错误");auto raw=q.value(3).toByteArray();need(sectorLeader::hash(raw)==q.value(2).toString(),"原配置摘要不符");current=observationJson(raw,2*1024*1024);observationRestore::configValid(current);need(current["revision"].toDouble()==q.value(1).toLongLong()&&!q.next(),"原配置版本错误");
 }
 need(scalar(db,"SELECT count(*) FROM observations")<=legacy::totalLimit&&scalar(db,"SELECT coalesce(sum(length(payload)),0) FROM observations")<=8*1024*1024,"人工原历史超过完整读取上限，未截断");QJsonArray shots;need(q.exec("SELECT id,sector_id,captured_at,digest,payload,typeof(id),typeof(sector_id),typeof(captured_at),typeof(digest),typeof(payload),length(payload) FROM observations ORDER BY id COLLATE BINARY"));while(q.next()){
  observationActive(cancel);for(int i=5;i<9;i++)need(q.value(i).toString()=="text","人工原观察索引字段类型错误");need(q.value(9).toString()=="blob"&&q.value(10).toLongLong()<=8*1024*1024,"人工原观察长度/类型错误");auto raw=q.value(4).toByteArray();need(sectorLeader::hash(raw)==q.value(3).toString(),"原观察摘要不符");auto s=observationJson(raw,8*1024*1024);observationRestore::shotValid(s);need(s["id"]==q.value(0).toString()&&s["sectorId"]==q.value(1).toString()&&s["capturedAt"]==q.value(2).toString(),"原观察身份/时刻索引不符");shots.append(s);
 }
 need(scalar(db,"SELECT count(*) FROM imports")<=10000&&scalar(db,"SELECT coalesce(sum(length(digest)+length(applied_at)),0) FROM imports")<=2*1024*1024,"原配置导入标记超限，未截断");QJsonArray imports;need(q.exec("SELECT digest,applied_at,typeof(digest),typeof(applied_at) FROM imports ORDER BY digest COLLATE BINARY"));while(q.next()){observationActive(cancel);need(q.value(2).toString()=="text"&&q.value(3).toString()=="text","原配置导入标记类型错误");auto digest=q.value(0).toString(),at=q.value(1).toString();recentRestore::digest(digest);recentRestore::stamp(at);imports.append(QJsonObject{{"digest",digest},{"appliedAt",at}});}
 QJsonArray receipts,migrations;QMap<QString,QJsonObject> retained;if(previous)*previous={};if(has){need(scalar(db,"SELECT count(*) FROM observation_restore_receipts")<=10000&&scalar(db,"SELECT coalesce(sum(length(payload)),0) FROM observation_restore_receipts")<=64*1024*1024,"人工恢复回执超过完整读取上限，未截断");need(q.exec("SELECT source_key,payload,typeof(source_key),typeof(payload),length(payload) FROM observation_restore_receipts ORDER BY source_key COLLATE BINARY"));while(q.next()){
  observationActive(cancel);need(q.value(2).toString()=="text"&&q.value(3).toString()=="blob"&&q.value(4).toLongLong()<=16*1024*1024,"人工恢复回执类型/长度错误");auto r=observationJson(q.value(1).toByteArray(),16*1024*1024);observationRestore::receiptValid(r);auto source=q.value(0).toString();need(r["sourceKey"]==source,"人工恢复回执键不符");receipts.append(QJsonObject{{"sourceKey",source},{"sha256",observationRestore::hash(r)}});if(r["schema"]==legacy::receiptSchema)migrations.append(r);for(auto v:r["legacyMigrations"].toArray())migrations.append(v);for(auto v:r["configVersions"].toArray())retained[observationRestore::hash(v)]=v.toObject();if(previous&&source==key)*previous=r;
 }}QJsonArray all;for(auto c:retained)all.append(c);observationActive(cancel);return observationRestore::snapshot(current,shots,all,{{"count",imports.size()},{"sha256",observationRestore::hash(imports)}},{{"count",receipts.size()},{"sha256",observationRestore::hash(receipts)}},has,legacy::migrations(migrations));
}
QJsonObject observationReadFile(QString file,const Cancel&cancel,QString key={},QJsonObject*previous=nullptr){ObservationConnection c(file,false,cancel);need(c.db.transaction(),"人工观察只读事务不可用");try{auto value=observationRead(c.db,cancel,key,previous);observationActive(cancel);need(c.db.commit());return value;}catch(...){c.db.rollback();throw;}}
}
QJsonObject Store::restoreSnapshot(const Cancel&cancel)const{return observationReadFile(file,cancel);}
QJsonObject Store::previewRestore(QJsonObject input,QJsonObject before,const Cancel&cancel)const{observationActive(cancel);observationRestore::snapshotValid(before);auto incoming=observationRestore::payload(input);QJsonObject prior;auto now=observationReadFile(file,cancel,observationRestore::hash(incoming),&prior);need(now["baseline"]==before["baseline"],"人工观察预览基线变化，未写库");return observationRestore::preview(incoming,now,prior);}
QJsonObject Store::commitRestore(QJsonObject p,const Cancel&cancel,std::function<void()> beforeCommit)const{
 observationActive(cancel);observationRestore::previewValid(p);QJsonObject prior;auto preflight=observationReadFile(file,cancel,p["sourceKey"].toString(),&prior);need(preflight["baseline"]==p["expected"],"人工观察确认基线变化，未打开写连接");if(p["noChange"].toBool()){need(prior==p["previousReceipt"].toObject()&&!prior.isEmpty(),"原人工观察回执变化");return prior;}
 ObservationConnection c(file,true,cancel);exec(c.db,"BEGIN IMMEDIATE");try{
  auto now=observationRead(c.db,cancel,p["sourceKey"].toString(),&prior);need(now["baseline"]==p["expected"]&&observationRestore::preview(p["incoming"].toObject(),now,prior)==p,"人工确认时原配置、历史或回执变化，整批未写");auto committed=now["payload"].toObject()["config"].toObject();if(p["configChanged"].toBool())committed=write(c.db,p["configPreview"].toObject()["config"].toObject(),qint64(committed["revision"].toDouble()),cancel);
  auto r=observationRestore::receipt(p,committed,QDateTime::currentDateTimeUtc().toString(Qt::ISODateWithMs));exec(c.db,"CREATE TABLE IF NOT EXISTS observation_restore_receipts(source_key TEXT PRIMARY KEY,payload BLOB NOT NULL)");QMap<QString,QJsonObject> incoming;for(auto v:p["incoming"].toObject()["observations"].toArray())incoming[v.toObject()["id"].toString()]=v.toObject();QSqlQuery q(c.db);
  for(auto v:p["actions"].toArray()){observationActive(cancel);auto a=v.toObject();if(a["status"]!="insert")continue;auto s=incoming.value(a["id"].toString());auto raw=QJsonDocument(s).toJson(QJsonDocument::Compact);need(q.prepare("INSERT INTO observations(id,sector_id,captured_at,digest,payload) VALUES(?,?,?,?,?)"));q.addBindValue(s["id"].toString());q.addBindValue(s["sectorId"].toString());q.addBindValue(s["capturedAt"].toString());q.addBindValue(sectorLeader::hash(raw));q.addBindValue(raw);need(q.exec(),"原观察ID插入冲突，整批回滚");}
  auto raw=QJsonDocument(r).toJson(QJsonDocument::Compact);need(scalar(c.db,"SELECT coalesce(sum(length(payload)),0) FROM observation_restore_receipts")+raw.size()<=64*1024*1024,"人工恢复回执总量超限，整批回滚");need(q.prepare("INSERT INTO observation_restore_receipts(source_key,payload) VALUES(?,?)"));q.addBindValue(r["sourceKey"].toString());q.addBindValue(raw);need(q.exec(),"原恢复回执出现并发，整批回滚");q.finish();QJsonObject saved;auto after=observationRead(c.db,cancel,r["sourceKey"].toString(),&saved);need(observationRestore::verify(p,r,after,saved),"人工恢复事务内完整回读不符，整批回滚");if(beforeCommit)beforeCommit();observationActive(cancel);exec(c.db,"COMMIT");return r;
 }catch(...){c.db.rollback();throw;}
}
bool Store::verifyRestore(QJsonObject p,QJsonObject r,QJsonObject after,const Cancel&cancel)const{QJsonObject saved;auto now=observationReadFile(file,cancel,p["sourceKey"].toString(),&saved);return now["baseline"]==after["baseline"]&&observationRestore::verify(p,r,now,saved);}
