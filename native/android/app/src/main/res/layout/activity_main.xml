<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
 <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
  <Button android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:textSize="28sp" android:contentDescription="返回主页" android:background="?android:attr/selectableItemBackgroundBorderless"/>
  <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="自选" android:maxLines="1" android:ellipsize="end" android:textColor="#172B45" android:textSize="17sp" android:textStyle="bold"/>
  <Button android:id="@+id/theme" android:layout_width="48dp" android:layout_height="48dp" android:text="深浅" android:textSize="12sp" android:background="?android:attr/selectableItemBackground"/>
  <Button android:id="@+id/manage" android:layout_width="48dp" android:layout_height="48dp" android:text="管理" android:textSize="12sp" android:background="?android:attr/selectableItemBackground"/>
 </LinearLayout>
 <HorizontalScrollView android:id="@+id/pageSwitch" android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none" android:visibility="gone"><LinearLayout android:id="@+id/pageTabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"/></HorizontalScrollView>
 <FrameLayout android:id="@+id/businessHost" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone"/>
 <LinearLayout android:id="@+id/home" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="4dp" android:gravity="center_vertical">
   <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="6dp" android:singleLine="true" android:textSize="14sp" android:paddingHorizontal="14dp" android:hint="搜索名称 / 代码" android:inputType="text"/>
   <Button android:id="@+id/recent" android:layout_width="56dp" android:layout_height="48dp" android:text="最近" android:textSize="12sp" android:padding="0dp" android:minWidth="0dp" android:background="?android:attr/selectableItemBackground"/>
  </LinearLayout>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none"><LinearLayout android:id="@+id/groups" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"/></HorizontalScrollView>
  <TextView android:id="@+id/marketOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textSize="11sp"/>
  <LinearLayout android:id="@+id/watchModes" android:layout_width="match_parent" android:layout_height="48dp" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:orientation="horizontal"/>
  <LinearLayout android:id="@+id/tableHeader" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp">
   <TextView android:id="@+id/nameColumn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="名称 / 代码" android:textSize="11sp"/>
   <TextView android:layout_width="84dp" android:layout_height="wrap_content" android:gravity="end" android:text="最新价" android:textSize="11sp"/>
   <TextView android:layout_width="86dp" android:layout_height="wrap_content" android:gravity="end" android:text="涨跌幅" android:textSize="11sp"/>
  </LinearLayout>
  <ListView android:id="@+id/stocks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#EDF0F4" android:dividerHeight="1dp"/>
  <GridView android:id="@+id/stockGrid" android:tag="stockGrid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:numColumns="2" android:stretchMode="columnWidth" android:paddingHorizontal="8dp" android:horizontalSpacing="4dp" android:verticalSpacing="4dp" android:clipToPadding="false" android:visibility="gone"/>
  <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="没有匹配标的，请更换搜索或管理自选" android:gravity="center" android:padding="24dp" android:visibility="gone"/>
  <TextView android:id="@+id/homeStatus" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="设计模拟 · 非实时 · 独立离线运行" android:textSize="10sp" android:textColor="#78879B"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
  <LinearLayout android:id="@+id/quoteHeader" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp">
   <TextView android:id="@+id/quote" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="24sp" android:textStyle="bold"/>
   <TextView android:id="@+id/quoteStats" android:layout_width="174dp" android:layout_height="wrap_content" android:textSize="10sp" android:lineSpacingExtra="2dp" android:gravity="end"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/toolbars" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:id="@+id/periods" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"/>
  </LinearLayout>
  <TextView android:id="@+id/readout" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:textSize="10sp" android:maxLines="2" android:textColor="#76849A"/>
  <LinearLayout android:id="@+id/chartArea" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
   <org.marketreview.nativeapp.MarketChart android:id="@+id/chart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
   <org.marketreview.nativeapp.MarketChart android:id="@+id/reference" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:visibility="gone"/>
  </LinearLayout>
  <TextView android:id="@+id/bookBelow" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:text="五档盘口 · 样本未提供　查看 →" android:textSize="12sp" android:visibility="gone"/>
  <LinearLayout android:id="@+id/indicators" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"/>
  <LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"/>
  <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:text="设计模拟 · 非实时｜九转公开规则，非买卖建议" android:textColor="#78879B" android:textSize="10sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"/>
</LinearLayout>
