{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "webstock.external-research-batch/v1",
  "type": "object",
  "required": ["schema", "source", "revision", "asOf", "automaticTrading", "artifacts", "deliveries"],
  "properties": {
    "schema": { "const": "webstock.external-research-batch/v1" },
    "automaticTrading": { "const": false },
    "revision": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "required": ["system", "taskId", "runId", "generatedAt"],
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 80 },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "generatedAt": { "type": "string", "format": "date-time", "maxLength": 60 },
        "model": { "type": "string", "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "asOf": {
      "type": "object",
      "required": ["marketDate", "observedAt", "timezone"],
      "properties": {
        "marketDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "observedAt": { "type": "string", "format": "date-time", "maxLength": 60 },
        "timezone": { "const": "Asia/Shanghai" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/researchPickArtifact" },
          { "$ref": "#/$defs/hotspotArtifact" },
          { "$ref": "#/$defs/industryChainArtifact" }
        ]
      }
    },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": { "enum": ["webstock-research", "tonghuashun-watchlist"] },
          "required": { "type": "boolean" },
          "artifactIds": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
          "policy": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "researchPickArtifact": {
      "type": "object",
      "required": ["kind", "schema", "payload"],
      "properties": {
        "artifactId": { "type": "string", "maxLength": 120 },
        "kind": { "const": "research-picks" },
        "schema": { "const": "webstock.research-picks/v1" },
        "payload": {
          "type": "object",
          "required": ["picks"],
          "properties": {
            "analysis": { "type": "string", "maxLength": 20000 },
            "picks": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["code", "name", "thesis", "risks", "evidenceRefs"],
                "properties": {
                  "rank": { "type": "integer", "minimum": 1 },
                  "priority": { "enum": ["重点", "观察"] },
                  "code": { "type": "string", "pattern": "^(000|001|002|003|300|301|302|600|601|603|605|688|689|920)\\d{3}$" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "thesis": { "type": "string", "minLength": 1, "maxLength": 4000 },
                  "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
                  "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://", "maxLength": 2000 } },
                  "includeInTonghuashun": { "type": "boolean", "default": false }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hotspotArtifact": {
      "type": "object",
      "required": ["kind", "schema", "payload"],
      "properties": {
        "artifactId": { "type": "string", "maxLength": 120 },
        "kind": { "const": "market-hotspots" },
        "schema": { "const": "webstock.market-hotspots/v1" },
        "payload": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "summary": { "type": "string", "maxLength": 10000 },
            "items": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["name", "thesis", "risks", "evidenceRefs"],
                "properties": {
                  "rank": { "type": "integer", "minimum": 1 },
                  "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "state": { "type": "string", "maxLength": 40 },
                  "thesis": { "type": "string", "minLength": 1, "maxLength": 4000 },
                  "drivers": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
                  "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 2000 } },
                  "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://", "maxLength": 2000 } },
                  "relatedCodes": { "type": "array", "items": { "type": "string", "pattern": "^\\d{6}$" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "industryChainArtifact": {
      "type": "object",
      "required": ["kind", "schema", "payload"],
      "properties": {
        "artifactId": { "type": "string", "maxLength": 120 },
        "kind": { "const": "industry-chain-updates" },
        "schema": { "const": "webstock.industry-chain-updates/v1" },
        "payload": {
          "type": "object",
          "required": ["chains"],
          "properties": {
            "summary": { "type": "string", "maxLength": 10000 },
            "chains": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["name", "thesis", "stages", "risks", "evidenceRefs"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "state": { "type": "string", "maxLength": 40 },
                  "thesis": { "type": "string", "minLength": 1, "maxLength": 4000 },
                  "stages": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 2000 } },
                  "catalysts": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
                  "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 2000 } },
                  "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://", "maxLength": 2000 } },
                  "relatedCodes": { "type": "array", "items": { "type": "string", "pattern": "^\\d{6}$" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
