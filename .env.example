# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=4096
OPENAI_TIMEOUT_MS=120000
OPENAI_ENABLED=true

# Optional read-only Tonghuashun holding export. The monitor accepts only a file
# updated on the current Shanghai trading date; otherwise use the in-app copy/paste sync.
# WEBSTOCK_THS_HOLDINGS_FILE=D:\path\to\holdings.csv
# WEBSTOCK_THS_HOLDINGS_DIR=D:\path\to\holding-exports
# Poll every 15 seconds; unchanged exports are deduplicated. A monitor export older
# than five minutes is blocked instead of being presented as a real-time holding.
# WEBSTOCK_THS_HOLDINGS_POLL_MS=15000
# WEBSTOCK_THS_HOLDINGS_MAX_AGE_MS=300000

# Douyin speech-to-text. Safe default remains local Whisper small.
# WEBSTOCK_ASR_PROVIDER=local
# WEBSTOCK_ASR_MODEL=small
# Use only after the local model is downloaded and benchmarked:
# WEBSTOCK_ASR_MODEL=large-v3-turbo
# Cloud alternative; requires OPENAI_API_KEY and uploads archived audio to the configured OpenAI endpoint:
# WEBSTOCK_ASR_PROVIDER=openai
# WEBSTOCK_ASR_OPENAI_MODEL=gpt-transcribe

# Optional. For most GPT-5 family models keep this unset.
# OPENAI_TEMPERATURE=0.3

# Server
PORT=3000
NODE_ENV=development

# Optional news JSON endpoint. Supports an array payload, { "items": [...] }, or { "data": [...] }.
# NEWS_JSON_URL=https://example.com/webstock-news.json

# Optional authorized Level-2 market data gateway.
# Use this only with a licensed provider API or local gateway. Do not reverse-engineer a retail quote client.
# LEVEL2_PROVIDER=tonghuashun-http
# LEVEL2_LOGIN_URL=https://quantapi.10jqka.com.cn/
# LEVEL2_BASE_URL=http://127.0.0.1:18180
# LEVEL2_API_KEY=
# LEVEL2_AUTH_HEADER=Authorization
# LEVEL2_AUTH_PREFIX=Bearer
# LEVEL2_DEPTH_ENDPOINT=/depth?code={code}
# LEVEL2_TRADES_ENDPOINT=/trades?code={code}&limit={limit}
# LEVEL2_ORDERS_ENDPOINT=/orders?code={code}&limit={limit}
# LEVEL2_TIMEOUT_MS=5000
# LEVEL2_LARGE_ORDER_THRESHOLD=500000
# LEVEL2_VOLUME_UNIT=share
# Fail-closed confirmation: set both to 1 only after verifying the gateway license
# and the account's entitlement to the requested Level-2 trade fields.
# LEVEL2_AUTHORIZATION_VERIFIED=0
# LEVEL2_ENTITLEMENT_VERIFIED=0
